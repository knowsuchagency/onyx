{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "onyx",
  "type": "registry:style",
  "title": "Onyx",
  "description": "Onyx design system as a shadcn preset — agent-orchestration control surface. Dark-first: near-black canvas, indigo accent, achromatic structure, semantic warn/danger/ok reserved for status. Space Grotesk + Geist + JetBrains Mono.",
  "cssVars": {
    "theme": {
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-destructive": "var(--destructive)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "color-chart-1": "var(--chart-1)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-5": "var(--chart-5)",
      "color-onyx-bg": "#06070C",
      "color-onyx-bg-1": "#0A0B12",
      "color-onyx-bg-2": "#11131C",
      "color-onyx-bg-vis": "#08091A",
      "color-onyx-fg": "#F4F5FA",
      "color-onyx-fg-1": "#B7BBC8",
      "color-onyx-fg-2": "#6B7080",
      "color-onyx-fg-3": "#3B3F4E",
      "color-onyx-line": "#1F2230",
      "color-onyx-line-1": "#2A2D3D",
      "color-onyx-line-active": "#3B3F5A",
      "color-onyx-line-dash": "#2A2D3D",
      "color-onyx-accent": "#7B7FFF",
      "color-onyx-accent-1": "#9498FF",
      "color-onyx-accent-2": "#5C61E6",
      "color-onyx-accent-fade": "rgba(123, 127, 255, 0.18)",
      "color-onyx-accent-grid": "rgba(123, 127, 255, 0.45)",
      "color-onyx-warn": "#F2B144",
      "color-onyx-warn-fade": "rgba(242, 177, 68, 0.16)",
      "color-onyx-danger": "#F2545B",
      "color-onyx-danger-fade": "rgba(242, 84, 91, 0.16)",
      "color-onyx-ok": "#4ADE9A",
      "color-onyx-ok-fade": "rgba(74, 222, 154, 0.16)",
      "font-sans": "'Geist', 'IBM Plex Sans', system-ui, sans-serif",
      "font-display": "'Space Grotesk', 'Geist', system-ui, sans-serif",
      "font-mono": "'JetBrains Mono', ui-monospace, 'SF Mono', monospace",
      "radius-sm": "calc(var(--radius) - 2px)",
      "radius-md": "var(--radius)",
      "radius-lg": "calc(var(--radius) + 2px)",
      "radius-xl": "calc(var(--radius) + 4px)",
      "radius-onyx-sm": "2px",
      "radius-onyx-md": "4px",
      "radius-onyx-lg": "6px",
      "ease-onyx": "cubic-bezier(0.2, 0.7, 0.1, 1)"
    },
    "light": {
      "background": "#F4F5FA",
      "foreground": "#06070C",
      "card": "#FFFFFF",
      "card-foreground": "#06070C",
      "popover": "#FFFFFF",
      "popover-foreground": "#06070C",
      "primary": "#5C61E6",
      "primary-foreground": "#F4F5FA",
      "secondary": "#E5E7F0",
      "secondary-foreground": "#06070C",
      "muted": "#E5E7F0",
      "muted-foreground": "#6B7080",
      "accent": "#7B7FFF",
      "accent-foreground": "#06070C",
      "destructive": "#F2545B",
      "destructive-foreground": "#F4F5FA",
      "border": "#D6D9E6",
      "input": "#D6D9E6",
      "ring": "#7B7FFF",
      "chart-1": "#7B7FFF",
      "chart-2": "#F2B144",
      "chart-3": "#F2545B",
      "chart-4": "#4ADE9A",
      "chart-5": "#9498FF",
      "radius": "0.25rem"
    },
    "dark": {
      "background": "#06070C",
      "foreground": "#F4F5FA",
      "card": "#0A0B12",
      "card-foreground": "#F4F5FA",
      "popover": "#11131C",
      "popover-foreground": "#F4F5FA",
      "primary": "#7B7FFF",
      "primary-foreground": "#06070C",
      "secondary": "#11131C",
      "secondary-foreground": "#F4F5FA",
      "muted": "#11131C",
      "muted-foreground": "#6B7080",
      "accent": "#5C61E6",
      "accent-foreground": "#F4F5FA",
      "destructive": "#F2545B",
      "destructive-foreground": "#F4F5FA",
      "border": "#1F2230",
      "input": "#11131C",
      "ring": "#7B7FFF",
      "chart-1": "#7B7FFF",
      "chart-2": "#F2B144",
      "chart-3": "#F2545B",
      "chart-4": "#4ADE9A",
      "chart-5": "#9498FF",
      "radius": "0.25rem"
    }
  },
  "css": {
    "::selection": {
      "background": "rgba(123, 127, 255, 0.18)",
      "color": "#F4F5FA"
    },
    ":focus-visible": {
      "outline": "1px solid #7B7FFF",
      "outline-offset": "2px"
    }
  }
}
